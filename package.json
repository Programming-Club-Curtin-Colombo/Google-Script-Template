{
  "name": "google-script-template",
  "version": "1.0.0",
  "private": true,
  "description": "Google Apps Script template with linting, formatting, and CI governance enforcement",
  "scripts": {
    "lint": "eslint . --ext .gs,.js",
    "lint:fix": "eslint . --ext .gs,.js --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "ci:lint": "eslint . --ext .gs,.js"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.83",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10"
}